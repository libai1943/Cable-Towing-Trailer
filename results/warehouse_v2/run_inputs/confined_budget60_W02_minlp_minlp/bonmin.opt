bonmin.algorithm B-BB
bonmin.time_limit 58
bonmin.bb_log_level 1
bonmin.nlp_log_level 0
linear_solver ma57
print_level 5
max_iter 3000
max_cpu_time 58
tol 1e-7
constr_viol_tol 1e-7
bound_relax_factor 0
bonmin.num_retry_unsolved_random_point 0
bonmin.nlp_failure_behavior fathom
bonmin.number_strong_branch 0
bonmin.solution_limit 1000000
